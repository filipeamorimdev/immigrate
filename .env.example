# Copy to .env. Docker Compose reads it automatically.

# NAS folder that holds your Photos library. You choose the library inside it in
# the web page. On TrueNAS, /mnt covers every pool. Synology uses /volume1,
# Unraid /mnt/user, and QNAP /share/CACHEDEV1_DATA. See the README for more.
NAS_FOLDER=/mnt

# User and group that can read the library.
IMMIGRATE_UID=1000
IMMIGRATE_GID=1000

# Port for the web page.
IMMIGRATE_PORT=8088

LOG_LEVEL=INFO

# Optional. You can enter these in the web page instead.
IMMICH_URL=
IMMICH_API_KEY=
